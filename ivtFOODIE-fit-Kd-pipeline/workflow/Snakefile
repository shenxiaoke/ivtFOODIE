def get_output_path_intersection_list(wildcards):
    """获取intersection文件列表的路径"""
    return str(get_state_dir() / ".motif_intersection_files.txt")

def get_output_path_visualization_list(wildcards):
    """获取visualization文件列表的路径"""
    return str(get_state_dir() / ".motif_visualization_files.txt")

def get_output_path_all_motif_outputs_done(wildcards):
    """获取所有motif输出完成标志文件的路径"""
    return str(get_state_dir() / ".all_motif_outputs_done")

