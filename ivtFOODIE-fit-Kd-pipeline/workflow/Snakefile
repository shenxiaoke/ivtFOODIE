            f"{get_output_dir()}/{{tf}}/03_fitting/{{tf}}.fittingKd.{{method}}.tsv",
            tf=get_all_tfs(),
            method=get_all_methods()
        )


# ========================================
# 清理规则
# ========================================

rule clean_intermediate:
    """清理中间文件，保留最终结果"""
    run:
        output_dir = get_output_dir()
        import subprocess
        print(f"Cleaning intermediate files in {output_dir}...")
        # 只删除压缩文件（保留footprints和Kd拟合结果）
        subprocess.run(f"rm -rf {output_dir}/*/01_compressed/", shell=True, check=False)
        print(f"Done. Kept: 02_integrated, 03_fitting, 04_footprints in {output_dir}")


rule clean_all:
    """清理所有生成的文件"""
    run:
        output_dir = get_output_dir()
        print(f"WARNING: This will delete all results in {output_dir}, logs, and benchmarks!")
        print("Press Ctrl+C to cancel, or Enter to continue...")
        try:
            input()  # Python equivalent of read
        except (EOFError, KeyboardInterrupt):
            print("Cancelled.")
            return
        import subprocess
        subprocess.run(f"rm -rf {output_dir}/ logs/ benchmarks/", shell=True, check=False)
        print("All cleaned.")


# ========================================
# 测试规则：用于调试单个TF
# ========================================

rule test_single_tf:
    """
    测试单个TF的完整workflow

    用法：
        snakemake test_single_tf --config test_tf=SP1
    """
    input:
        lambda wildcards: expand(
            f"{get_output_dir()}/{{tf}}/04_footprints/{{tf}}.footprint.{{method}}.{{kd_thres_type}}.bed",
            tf=config.get("test_tf", get_all_tfs()[0]),
            method=get_all_methods(),
            kd_thres_type=get_all_threshold_types()
        )


# ========================================
# 报告和统计
# ========================================

rule workflow_report:
    """
    生成workflow运行报告

    包含：
        - 每个TF的处理状态
        - Kd拟合成功率
        - Footprint数量统计
        - 运行时间统计
    """
    input:
        lambda wildcards: expand(
            f"{get_output_dir()}/{{tf}}/04_footprints/{{tf}}.footprint.{{method}}.{{kd_thres_type}}.stats.txt",
            tf=get_all_tfs(),
            method=get_all_methods(),
            kd_thres_type=get_all_threshold_types()
        )
    output:
        "report/workflow_summary.html"
    run:
        import json
        from datetime import datetime

        # 收集统计信息
        summary = {
            "timestamp": datetime.now().isoformat(),
            "tfs": {}
        }

        for tf in get_all_tfs():
            tf_summary = {
                "methods": {}
            }

            for method in get_all_methods():
                method_summary = {
                    "thresholds": {}
                }

                for kd_thres_type in get_all_threshold_types():
                    output_dir = get_output_dir()
                    stats_file = f"{output_dir}/{tf}/04_footprints/{tf}.footprint.{method}.{kd_thres_type}.stats.txt"

                    if Path(stats_file).exists():
                        with open(stats_file) as f:
                            stats_content = f.read()
                            # 解析统计信息
                            for line in stats_content.split('\n'):
                                if "Total footprints:" in line:
                                    count = int(line.split(':')[1].strip())
                                    method_summary["thresholds"][kd_thres_type] = {
                                        "footprint_count": count
                                    }

                tf_summary["methods"][method] = method_summary

            summary["tfs"][tf] = tf_summary

        # 生成HTML报告
        html = f"""
        <!DOCTYPE html>
        <html>
        <head>
            <title>ivtFOODIE Workflow Summary</title>
            <style>
                body {{ font-family: Arial, sans-serif; margin: 20px; }}
                table {{ border-collapse: collapse; width: 100%; margin-top: 20px; }}
                th, td {{ border: 1px solid #ddd; padding: 8px; text-align: left; }}
                th {{ background-color: #4CAF50; color: white; }}
                h1 {{ color: #333; }}
                .timestamp {{ color: #666; font-size: 0.9em; }}
            </style>
        </head>
        <body>
            <h1>ivtFOODIE Postprocessing Workflow Summary</h1>
            <p class="timestamp">Generated: {summary['timestamp']}</p>

            <h2>Footprint Statistics</h2>
            <table>
                <tr>
                    <th>TF</th>
                    <th>Method</th>
                    <th>Threshold Type</th>
                    <th>Footprint Count</th>
                </tr>
        """

        for tf, tf_data in summary["tfs"].items():
            for method, method_data in tf_data["methods"].items():
                for kd_thres, thres_data in method_data["thresholds"].items():
                    count = thres_data.get("footprint_count", 0)
                    html += f"""
                <tr>
                    <td>{tf}</td>
                    <td>{method}</td>
                    <td>{kd_thres}</td>
                    <td>{count}</td>
                </tr>
                    """

        html += """
            </table>

            <h2>JSON Data</h2>
            <pre>{json_data}</pre>
        </body>
        </html>
        """.format(json_data=json.dumps(summary, indent=2))

        # 输出HTML
        Path("report").mkdir(exist_ok=True)
        with open(output[0], 'w') as f:
            f.write(html)

        print(f"\nReport saved to: {output[0]}")


# ========================================
# Workflow完成时的钩子
# ========================================

onsuccess:
    print("\n" + "="*60)
    print("Workflow completed successfully!")
    print("="*60)
    output_dir = get_output_dir()
    print("\nOutput files:")
    print(f"  - Kd fitting results: {output_dir}/*/03_fitting/")
    print(f"  - Footprints: {output_dir}/*/04_footprints/")
    print("\nTo generate a summary report, run:")
    print("  snakemake workflow_report")
    print("="*60 + "\n")


onerror:
    print("\n" + "="*60)
    print("Workflow failed!")
    print("="*60)
    print("\nCheck logs in logs/ directory for details")
    print("="*60 + "\n")
