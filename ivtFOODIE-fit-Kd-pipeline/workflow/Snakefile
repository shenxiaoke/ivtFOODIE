# ========================================
# 辅助函数
# ========================================

def load_sample_sheet(tf_name: str) -> pd.DataFrame:
    """
    加载TF的sample sheet

    参数：
        tf_name: TF名称

    返回：
        Sample sheet的DataFrame
    """
    tf_config = config["tfs"][tf_name]
    sample_sheet_path = tf_config.get("sample_sheet")

    if not sample_sheet_path:
        return None

    # 解析sample sheet路径：如果是相对路径，相对于项目根目录
    sample_sheet_path_obj = Path(sample_sheet_path)
    if not sample_sheet_path_obj.is_absolute():
        # 使用项目根目录（已在全局作用域中定义）作为基准
        sample_sheet_path_obj = project_root / sample_sheet_path_obj

    # 读取sample sheet
    sheet = pd.read_csv(sample_sheet_path_obj, sep='\t')

    # 验证必需列
    required_columns = ["sample_id", "concentration_M", "folder_name"]
    for col in required_columns:
        if col not in sheet.columns:
            raise ValueError(
                f"Sample sheet for {tf_name} missing required column: {col}"
            )

    return sheet


def get_sample_info(tf_name: str) -> Dict:
    """
    获取TF的样本信息（支持sample sheet或直接配置）

    返回：
        {
            'sample_ids': [...],      # 样本ID列表
            'sample_files': [...],    # 样本文件路径列表
            'concentrations': [...],  # 浓度列表
            'fitting_indices': [...]  # 拟合索引列表
        }
    """
    tf_config = config["tfs"][tf_name]

    # 方式1：使用sample sheet
    if "sample_sheet" in tf_config:
        sheet = load_sample_sheet(tf_name)
        
        if sheet is None:
            raise ValueError(
                f"TF '{tf_name}': Failed to load sample sheet. "
                f"Check that 'sample_sheet' path is correct: {tf_config.get('sample_sheet')}"
            )

        # 获取配置
        base_path = Path(tf_config.get("sample_base_path", ""))
        file_pattern = tf_config.get("sample_file_pattern", "{folder_name}_sites.txt")

        # 构建文件路径列表
        sample_files = []
        for _, row in sheet.iterrows():
            folder_name = row["folder_name"]
            file_path = base_path / file_pattern.format(folder_name=folder_name)
            sample_files.append(str(file_path))

        # 确保concentration_M列存在
        if "concentration_M" not in sheet.columns:
            raise ValueError(
                f"TF '{tf_name}': Sample sheet missing required column 'concentration_M'. "
                f"Found columns: {sheet.columns.tolist()}"
            )

        return {
            'sample_ids': sheet["sample_id"].tolist(),
            'sample_files': sample_files,
            'concentrations': sheet["concentration_M"].tolist(),
            'fitting_indices': tf_config.get("fitting_indices", list(range(len(sheet))))
        }

    # 方式2：直接从配置读取
    elif "sample_files" in tf_config:
        sample_files = tf_config["sample_files"]
        concentrations = tf_config.get("concentrations", [])

        # 如果有samples_from/to，用它们生成sample_id
        if "samples_from" in tf_config and "samples_to" in tf_config:
            samples_from = tf_config["samples_from"]
            samples_to = tf_config["samples_to"]
            sample_pattern = tf_config.get("sample_name_pattern", "{tf}-{i}")
            sample_ids = [
                sample_pattern.format(tf=tf_name, i=i)
                for i in range(samples_from, samples_to + 1)
            ]
        else:
            # 否则生成默认ID
            sample_ids = [f"{tf_name}-{i+1}" for i in range(len(sample_files))]

        return {
            'sample_ids': sample_ids,
            'sample_files': sample_files,
            'concentrations': concentrations,
            'fitting_indices': tf_config.get("fitting_indices", list(range(len(sample_files))))
        }

    else:
        raise ValueError(
            f"TF '{tf_name}': Must specify either 'sample_sheet' or 'sample_files'"
        )


def get_sample_names(tf_name: str) -> List[str]:
    """
    根据TF名称获取样本名称列表

    参数：
        tf_name: TF名称

    返回：
        样本名称列表（用于文件名）
    """
    info = get_sample_info(tf_name)
    return info['sample_ids']


def get_preliminary_motif(tf_name: str) -> str:
    """
    获取preliminary motif文件路径

    逻辑：
        1. 如果config中指定了preliminary_motif，使用它
        2. 否则，从basic方法的footprint结果中选择一个阈值类型
           （默认选择第一个阈值类型）

    参数：
        tf_name: TF名称

    返回：
        Motif文件路径
    """
    tf_config = config["tfs"][tf_name]

    # 如果用户指定了preliminary motif
    preliminary_motif = tf_config.get("preliminary_motif")
    if preliminary_motif:
        return preliminary_motif

    # 否则，从basic footprint结果中选择
    # 默认使用第一个阈值类型
    default_thres_type = list(config["footprint_thresholds"].keys())[0]
    output_dir = get_output_dir()
    return f"{output_dir}/{tf_name}/04_footprints/{tf_name}.footprint.basic.{default_thres_type}.bed"


def get_all_tfs() -> List[str]:
    """获取所有TF名称"""
    return list(config["tfs"].keys())


def get_all_methods() -> List[str]:
    """获取所有Kd拟合方法"""
    return ["basic", "flank_corrected"]


def get_all_threshold_types() -> List[str]:
    """获取所有Kd阈值类型"""
    return list(config["footprint_thresholds"].keys())


def get_output_dir() -> str:
    """
    获取输出目录路径
    
    从config文件中读取output_dir配置，如果未指定则默认为"../results"
    如果是相对路径，会相对于项目根目录（workflow目录的父目录）解析
    
    返回：
        输出目录路径（字符串，绝对路径或相对于项目根目录的路径）
    """
    output_dir = config.get("output", {}).get("output_dir", "../results")

    # 如果是相对路径，需要相对于项目根目录（workflow目录的父目录）解析
    output_dir_path = Path(output_dir)
    if not output_dir_path.is_absolute():
        # 使用项目根目录（已在全局作用域中定义）作为基准
        output_dir_path = project_root / output_dir_path

    # 关键：规范化路径，消除 ".." 等，避免 Snakemake DAG 匹配时的字符串不一致
    # strict=False 允许路径尚不存在
    output_dir_path = output_dir_path.resolve(strict=False)

    return str(output_dir_path)


def get_cluster_partition(wildcards) -> str:
    """
    获取SLURM分区名称
    
    从config文件中读取cluster.partition配置，如果未指定则默认为"normal"
    
    参数：
        wildcards: Snakemake wildcards对象（即使不使用也需要接受）
    
    返回：
        分区名称（字符串）
    """
    return config.get("cluster", {}).get("partition", "normal")


def get_cluster_time(wildcards) -> str:
    """
    获取SLURM任务运行时间
    
    从config文件中读取default_resources.runtime配置，如果未指定则默认为"7:00:00"
    
    参数：
        wildcards: Snakemake wildcards对象（即使不使用也需要接受）
    
    返回：
        运行时间（字符串，格式：HH:MM:SS）
    """
    return config.get("default_resources", {}).get("runtime", "7:00:00")


def get_state_dir() -> Path:
    """
    获取 Snakemake 工作目录（用于存放 workflow 内部状态文件）。

    说明：
    - 提交脚本使用 `--directory .snakemake-xxx` 并行运行多个 config。
    - 若把内部点文件写到 results/ 根目录，会在多 config 并行时互相覆盖、串台。
    - 因此将内部状态文件放到当前工作目录（即 --directory 指定的目录）下。
    """
    # Snakemake 会在执行阶段将 cwd 切到 --directory 指定的 workdir
    return Path(os.getcwd())


def get_motifs_from_meme_file(meme_file):
    """
    从MEME文件中提取motif列表
    
    参数：
        meme_file: MEME文件路径
    
    返回：
        motif名称列表
    """
    from pathlib import Path
    import subprocess
    
    # 获取项目根目录
    if hasattr(workflow, 'basedir'):
        project_dir = Path(workflow.basedir).parent
    else:
        project_dir = Path(workflow.snakefile).parent.parent
    extract_script = project_dir / "workflow" / "scripts" / "motif" / "extract_motif_list.py"
    
    meme_path = Path(meme_file)
    if not meme_path.exists():
        return []
    
    try:
        result = subprocess.run(
            [sys.executable, str(extract_script), str(meme_path)],
            capture_output=True,
            text=True,
            timeout=10,
            cwd=str(project_dir)
        )
        if result.returncode == 0:
            motifs = [m for m in result.stdout.strip().split(',') if m]
            return motifs
    except Exception as e:
        pass
    
    return []


def read_file_list(file_path):
    """
    从文件中读取文件路径列表
    
    参数：
        file_path: 文件路径
    
    返回：
        文件路径列表（去除空行）
    """
    from pathlib import Path
    path = Path(file_path)
    if not path.exists():
        return []
    try:
        with open(path, 'r') as f:
            # 规范化每一行路径，消除 ".." 等，避免与规则 output 的路径表示不一致
            normalized = []
            for line in f:
                s = line.strip()
                if not s:
                    continue
                normalized.append(str(Path(s).resolve(strict=False)))
            return normalized
    except Exception:
        return []


def get_intersection_files(wildcards):
    """
    从文件列表中读取intersection文件路径
    
    参数：
        wildcards: Snakemake wildcards
        input: Snakemake input对象（可选）
    
    返回：
        intersection文件路径列表
    """
    # 关键：通过 checkpoint.get() 强制 Snakemake 先运行 checkpoint 并更新 DAG
    ckpt = checkpoints.aggregate_motif_outputs.get()
    list_file = ckpt.output.intersection_list
    return read_file_list(list_file)


def get_visualization_files(wildcards):
    """
    从文件列表中读取visualization文件路径
    
    参数：
        wildcards: Snakemake wildcards
        input: Snakemake input对象（可选）
    
    返回：
        visualization文件路径列表
    """
    # 关键：通过 checkpoint.get() 强制 Snakemake 先运行 checkpoint 并更新 DAG
    ckpt = checkpoints.aggregate_motif_outputs.get()
    list_file = ckpt.output.visualization_list
    return read_file_list(list_file)


def get_output_path_aggregate_done(wildcards):
