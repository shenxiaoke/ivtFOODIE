# ========================================
# 本地规则（不提交到集群）
# ========================================
#
# 这两个规则只负责生成 workflow 内部的列表/标记文件，不需要占用计算节点。
localrules: aggregate_motif_outputs, all_motif_outputs


# ========================================
# Aggregate规则：在checkpoint完成后收集所有meme文件并生成后续目标
# ========================================

checkpoint aggregate_motif_outputs:
    input:
        # 等待所有streme checkpoint完成
        meme_files=lambda wildcards: [
            checkpoints.streme_enrich.get(**{
                "tf": tf,
                "method": method,
                "kd_thres_type": kd_thres_type
            }).output.meme
            for tf in get_all_tfs()
            for method in get_all_methods()
            for kd_thres_type in get_all_threshold_types()
        ]
    output:
        # 占位符输出，用于触发后续规则
        aggregate_done=STATE_DIR_FOR_RULES + "/.motif_aggregate_done",
        # 文件列表文件，供后续规则使用
        intersection_list=STATE_DIR_FOR_RULES + "/.motif_intersection_files.txt",
        visualization_list=STATE_DIR_FOR_RULES + "/.motif_visualization_files.txt"
    threads: 1
    resources:
        mem_mb=lambda wildcards: config.get("default_resources", {}).get("mem_mb", 1000),
        partition=get_cluster_partition,
        time=get_cluster_time
    run:
        # 读取所有meme文件，提取motif列表，并生成后续目标文件列表
        # 使用规范化后的输出目录，避免写入列表文件时包含 ".."
        output_dir = str(Path(get_output_dir()).resolve(strict=False))
        all_intersection_outputs = []
        all_visualization_outputs = []
        
        for tf in get_all_tfs():
            for method in get_all_methods():
                for kd_thres_type in get_all_threshold_types():
                    meme_file = checkpoints.streme_enrich.get(**{
                        "tf": tf,
                        "method": method,
                        "kd_thres_type": kd_thres_type
                    }).output.meme
                    
                    motifs = get_motifs_from_meme_file(meme_file)
                    for motif_name in motifs:
                        # FIMO扫描输出（作为中间步骤）
                        fimo_bed = f"{output_dir}/{tf}/05_motifs/fimo/{tf}.footprint.{method}.{kd_thres_type}.motif_{motif_name}.bed"
                        # 开放区交集输出
                        intersection_file = f"{output_dir}/{tf}/06_binding_sites/{tf}.footprint.{method}.{kd_thres_type}.motif_{motif_name}.open_region.bed"
                        # 可视化输出
                        visualization_file = f"{output_dir}/{tf}/07_visualization/{tf}.footprint.{method}.{kd_thres_type}.motif_{motif_name}.conversion_plot.pdf"
                        all_intersection_outputs.append(intersection_file)
                        all_visualization_outputs.append(visualization_file)
        
        # 创建标记文件
        Path(output.aggregate_done).parent.mkdir(parents=True, exist_ok=True)
        Path(output.aggregate_done).touch()
        
        # 将文件列表写入文件，供后续规则使用
        Path(output.intersection_list).parent.mkdir(parents=True, exist_ok=True)
        Path(output.visualization_list).parent.mkdir(parents=True, exist_ok=True)
        
        with open(output.intersection_list, 'w') as f:
            # 再次规范化，确保列表文件内容不含 ".."
            f.write('\n'.join(str(Path(p).resolve(strict=False)) for p in all_intersection_outputs))
        
        with open(output.visualization_list, 'w') as f:
            f.write('\n'.join(str(Path(p).resolve(strict=False)) for p in all_visualization_outputs))


# ========================================
# 目标规则：定义workflow的最终输出
# ========================================

rule all:
    input:
        conversion_qc_gate,
        # 所有TF的所有footprint结果
        lambda wildcards: expand(
            f"{get_output_dir()}/{{tf}}/04_footprints/{{tf}}.footprint.{{method}}.{{kd_thres_type}}.bed",
            tf=get_all_tfs(),
            method=get_all_methods(),
            kd_thres_type=get_all_threshold_types()
        ),
        # 所有TF的Kd拟合结果
        lambda wildcards: expand(
            f"{get_output_dir()}/{{tf}}/03_fitting/{{tf}}.fittingKd.{{method}}.tsv",
            tf=get_all_tfs(),
            method=get_all_methods()
        ),
        # 所有TF的meme文件（通过checkpoint生成）
        # 这会触发streme_enrich checkpoint的执行
        lambda wildcards: expand(
            f"{get_output_dir()}/{{tf}}/05_motifs/streme/{{tf}}.footprint.{{method}}.{{kd_thres_type}}.meme",
            tf=get_all_tfs(),
            method=get_all_methods(),
            kd_thres_type=get_all_threshold_types()
        ),
        # 等待motif聚合完成，这会触发后续规则的动态生成
        aggregate_output=get_output_path_aggregate_done,
        # 包含所有motif相关的输出（通过all_motif_outputs规则生成）
        # 注意：all_motif_outputs规则的output是动态的，我们通过引用这个规则来触发所有文件的生成
        motif_outputs_done=get_output_path_all_motif_outputs_done
    default_target: True


# ========================================
# 辅助规则：读取文件列表并请求所有motif相关的输出
# ========================================

rule all_motif_outputs:
    """
    显式请求所有motif相关的输出文件
    这个规则会在aggregate规则完成后读取文件列表，并请求所有目标文件
    
    注意：这个规则的input是动态的，依赖于文件列表中的内容
    我们使用input函数在input中读取文件列表，这样Snakemake会确保这些文件被生成
    """
    input:
        aggregate_done=get_output_path_aggregate_done,
        intersection_list=get_output_path_intersection_list,
        visualization_list=get_output_path_visualization_list,
        # 动态读取文件列表中的所有文件作为input
        # 使用input函数读取列表文件，确保在aggregate规则完成后才读取
        intersection_files=get_intersection_files,
        visualization_files=get_visualization_files
    output:
        # 占位符输出，表示所有motif相关的输出已完成
        STATE_DIR_FOR_RULES + "/.all_motif_outputs_done"
    threads: 1
    resources:
        mem_mb=lambda wildcards: config.get("default_resources", {}).get("mem_mb", 1000),
        partition=get_cluster_partition,
        time=get_cluster_time
    run:
        # 创建标记文件
        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
        Path(output[0]).touch()
        
        # 注意：实际的文件会由其他规则（fimo_scan_per_motif, intersect_open_regions_per_motif, motif_conversion_plot_per_motif）生成
        # 通过将这些文件作为input，Snakemake会确保它们被生成


